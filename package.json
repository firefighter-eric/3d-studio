{
  "name": "3d-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "tsx --test src/game/simulation.test.ts src/racing/race.test.ts src/spacecraft/spacecraft.test.ts src/animation/mission.test.ts src/animation/falcon-heavy/mission.test.ts src/animation/falcon-heavy/film.test.ts src/apple/apple.test.ts src/dji/dji.test.ts src/nvidia/nvidia.test.ts src/data/model-library.test.ts src/tesla/tesla.test.ts src/consoles/consoles.test.ts",
    "models:export": "tsx scripts/export-racecars.ts",
    "models:spacecraft": "tsx scripts/export-spacecraft.ts",
    "film:falcon-heavy": "node scripts/render-falcon-heavy-film.mjs",
    "models:apple": "tsx scripts/optimize-apple-models.ts",
    "test:race": "tsx scripts/check-race-balance.ts",
    "preview": "node scripts/serve.mjs preview",
    "models:dji": "tsx scripts/import-dji.ts",
    "test:dji": "tsx --test src/dji/dji.test.ts",
    "models:nvidia": "tsx scripts/export-nvidia.ts",
    "models:nvidia:previews": "node scripts/render-nvidia-previews.mjs",
    "test:nvidia": "tsx --test src/nvidia/nvidia.test.ts",
    "models:tesla": "tsx scripts/export-tesla.ts",
    "models:tesla:previews": "node scripts/render-tesla-previews.mjs",
    "test:tesla": "tsx --test src/tesla/tesla.test.ts",
    "models:consoles": "tsx scripts/export-consoles.ts",
    "models:consoles:previews": "node scripts/render-consoles-previews.mjs",
    "test:consoles": "tsx --test src/consoles/consoles.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "draco3dgltf": "1.5.7",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
